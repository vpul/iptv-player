{
  "name": "iptv-player",
  "description": "Still — a calm IPTV player. Live channels curated from the iptv-org database.",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
